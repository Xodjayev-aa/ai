# ── Copy this file to `.env` (git-ignored) — every value is OPTIONAL ──────
# Aether is keyless: chat, voice, images and presentations all work with an
# empty environment. There are no AI API keys to fill in, ever.

# Signs session JWTs. Recommended in production.
# Without it the key is derived from TURSO_AUTH_TOKEN, or generated per
# process (logins then reset on restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# The email that is automatically made admin on registration
OWNER_EMAIL=

# Comma-separated CORS origins for your deployed frontend (default: *)
ALLOWED_ORIGINS=

# Per-user daily AI request cap (default 300)
DAILY_REQUEST_LIMIT=300

# ── Database ─────────────────────────────────────────────────────────────
# Option A (recommended on Vercel): Turso — free persistent SQLite over HTTP.
#   turso db create aether
#   turso db show aether --http-url
#   turso db tokens create aether
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Option B: local SQLite file (used automatically when Turso vars are empty)
DATABASE_URL=sqlite:///./aether.db

# ── Scheduled tasks ──────────────────────────────────────────────────────
# Protects /api/cron/daily; Vercel sends it automatically as a Bearer header.
CRON_SECRET=

# ── Developer conveniences (optional) ────────────────────────────────────
# Override the keyless upstream base URL (leave empty for the public default)
POLLINATIONS_BASE_URL=
# Pacing between free-tier chat calls, in seconds (default 5, max 45)
KEYLESS_MIN_INTERVAL=
# Pacing between free-tier text-to-speech calls, in seconds (default 0.5)
KEYLESS_TTS_MIN_INTERVAL=
