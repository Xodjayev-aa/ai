# ── Copy this file to `.env` (it is git-ignored) and fill in real values ──
# NEVER paste real keys into chat. Put them here or in Vercel env vars.

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me

# The email that is automatically made admin on registration
OWNER_EMAIL=you@example.com

# Comma-separated CORS origins for your deployed frontend
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────
# Option A (recommended for Vercel): Turso — free persistent SQLite.
#   turso db create aether
#   turso db show aether --http-url
#   turso db tokens create aether
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Option B: local SQLite file (used automatically if Turso vars are empty)
DATABASE_URL=sqlite:///./aether.db

# ── AI providers — ONE key is enough (Gemini does chat+STT+TTS) ──────────
# Google AI Studio (recommended): https://aistudio.google.com — free, no card
GEMINI_API_KEY=
# Groq — optional extra capacity + faster Whisper: https://console.groq.com
GROQ_API_KEY=
# Cerebras — optional 2 keys for rotation: https://cloud.cerebras.ai
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=

# Model overrides (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_FAST_MODEL=llama-3.1-8b

# ── Speech (uses Groq) ───────────────────────────────────────────────────
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# ── Images (Pollinations — works with no key) ────────────────────────────
IMAGE_MODEL=flux
POLLINATIONS_TOKEN=

# ── Limits / tuning ──────────────────────────────────────────────────────
DAILY_REQUEST_LIMIT=300
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=8000
CHAT_TIMEOUT_SECONDS=60
